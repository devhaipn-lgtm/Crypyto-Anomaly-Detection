          },
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      }
    },
    {
      "id": 12,
      "title": "SOLUSDT",
      "type": "stat",
      "gridPos": { "h": 5, "w": 4, "x": 8, "y": 23 },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse-crypto" },
      "targets": [
        {
          "rawSql": "SELECT round(price, 2) AS price FROM crypto.market_data WHERE symbol = 'SOLUSDT' ORDER BY event_time DESC LIMIT 1",
          "refId": "A",
          "format": 1
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "#9b59b6", "value": null }]
          },
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      }
    },
    {
      "id": 13,
      "title": "DOGEUSDT",
      "type": "stat",
      "gridPos": { "h": 5, "w": 4, "x": 12, "y": 23 },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse-crypto" },
      "targets": [
        {
          "rawSql": "SELECT round(price, 4) AS price FROM crypto.market_data WHERE symbol = 'DOGEUSDT' ORDER BY event_time DESC LIMIT 1",
          "refId": "A",
          "format": 1
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "#1abc9c", "value": null }]
          },
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      }
    },
    {
      "id": 14,
      "title": "BNBUSDT",
      "type": "stat",
      "gridPos": { "h": 5, "w": 4, "x": 16, "y": 23 },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse-crypto" },
      "targets": [
        {
          "rawSql": "SELECT round(price, 2) AS price FROM crypto.market_data WHERE symbol = 'BNBUSDT' ORDER BY event_time DESC LIMIT 1",
          "refId": "A",
          "format": 1
        }
      ],
      "fieldConfig": {
        "defaults": {
