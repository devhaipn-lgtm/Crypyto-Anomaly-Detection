          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "#e67e22", "value": null }]
          },
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      }
    },
    {
      "id": 15,
      "title": "XRPUSDT",
      "type": "stat",
      "gridPos": { "h": 5, "w": 4, "x": 20, "y": 23 },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse-crypto" },
      "targets": [
        {
          "rawSql": "SELECT round(price, 4) AS price FROM crypto.market_data WHERE symbol = 'XRPUSDT' ORDER BY event_time DESC LIMIT 1",
          "refId": "A",
          "format": 1
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "#5dade2", "value": null }]
          },
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      }
    }
  ],
  "style": "dark",
  "templating": { "list": [] },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse-crypto" },
        "enable": true,
        "hide": false,
        "iconColor": "#e74c3c",
        "name": "Anomalies",
        "target": {
          "rawSql": "SELECT event_time AS time, concat('Anomaly: ', symbol, ' Vol=', toString(round(volume, 2))) AS text, symbol AS tags FROM crypto.market_data WHERE is_anomaly = 1 AND $__timeFilter(event_time)"
        }
      }
    ]
  }
}
